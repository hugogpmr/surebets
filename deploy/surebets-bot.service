[Unit]
Description=Surebets - bot de Telegram (/hoy /ahora /stats)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=PYTHONPATH=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python scripts/run_telegram_bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
