TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Nombre del tema (topic) del chat/grupo anterior donde se publican los avisos de
# surebets. Vacío = se manda al chat sin tema. Se crea solo (el bot necesita permiso
# "Gestionar temas" si es un grupo) la primera vez y el id se cachea en disco.
TELEGRAM_TOPIC_NAME=
BANKROLL=250
MIN_MARGIN=0.01
FETCH_INTERVAL_SECONDS=60
DB_PATH=surebets.db
# Escaneos seguidos en los que debe aparecer una surebet antes de avisar (1 = a la primera)
CONFIRM_CYCLES=2
# Redondeo de los importes del reparto, en € (0 = exactos al céntimo)
ROUND_STEP=5
# Margen a partir del cual: se avisa de "margen alto" / hay que verificarla antes de avisar /
# se descarta como error de datos
WARN_MARGIN=0.05
VERIFY_MARGIN=0.15
MAX_MARGIN=0.25
# Escaneos seguidos que necesita una surebet de margen muy alto que no se puede verificar en directo
VERIFY_CYCLES=3
# Escaneo en dos ritmos: presupuesto del ciclo lento (min), partidos por competición, y edad máxima de la caché (h)
SLOW_BUDGET_MINUTES=20
SLOW_MAX_MATCHES=12
COMPARATOR_MAX_AGE_HOURS=8
# Filtros de partidos en Altenar/Kambi (1 = excluir, 0 = incluir): fútbol virtual/e-soccer y fútbol femenino
EXCLUDE_ESPORTS=1
EXCLUDE_WOMENS_FOOTBALL=1
# Horizonte (h) y tope de partidos por competición de las fuentes directas nuevas
BWIN_HORIZON_HOURS=48
WINAMAX_HORIZON_HOURS=96
WINAMAX_MAX_MATCHES=12

# --- Betfair Exchange API oficial (providers/betfair_exchange.py) ---
# Opcional: sin estas tres, ese provider se salta solo sin romper el escaneo.
# BETFAIR_APP_KEY: Delayed App Key gratuita, se genera en developer.betfair.com
# BETFAIR_USERNAME/BETFAIR_PASSWORD: los de tu cuenta normal de Betfair
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Comisión de Betfair sobre la ganancia neta de cada mercado (la ves en "Mi cuenta")
BETFAIR_EXCHANGE_COMMISSION=0.05

# --- Relay de Telegram (telegram_source/relay.py) ---
# api_id/api_hash: my.telegram.org > API development tools (con tu cuenta real, sin VPN)
TG_API_ID=
TG_API_HASH=
# id del grupo origen (sale de: python -m telegram_source.relay chats) o su titulo exacto
RELAY_SOURCE_CHAT=
# chat destino donde el bot publica (el bot debe estar dentro)
RELAY_TARGET_CHAT_ID=
# opcional: token de otro bot; si no, usa TELEGRAM_BOT_TOKEN
RELAY_BOT_TOKEN=
RELAY_SHOW_SENDER=1
# sustituye la linea "Consejo: ..." de los mensajes copiados (vacio = quitarla; sin definir = dejarla igual)
# RELAY_TIP_TEXT=
# temas del origen a copiar (ids o nombres, separados por comas). Si esta vacio se copian todos menos los de RELAY_SKIP_TOPICS
RELAY_ONLY_TOPICS=
RELAY_SKIP_TOPICS=
